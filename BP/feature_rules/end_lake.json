{
  "format_version": "1.26.0",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "betterend:end_lake",
      "places_feature": "betterend:end_lake_area"
    },
    "conditions": {
      "placement_pass": "surface_pass",
      "minecraft:biome_filter": {
        "test": "has_biome_tag",
        "operator": "==",
        "value": "the_end"
      }
    },
    "distribution": {
      "iterations": "temp.index == 0 ? math.random_integer(1, 40) == 1 : 0",
      "x": {
        "distribution": "fixed_grid",
        "extent": [ 0, 15 ]
      },
      "y": "t.size = math.random_integer(5, 10); temp.heightmap = query.heightmap(variable.worldx, variable.worldz); return temp.heightmap + 20;",
      "z": {
        "distribution": "fixed_grid",
        "extent": [ 0, 15 ]
      }
    }
  }
}